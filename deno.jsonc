{
  // The only in-code representation of the version. Bumped by release-please
  // when a release PR merges — the trailing annotation is how it finds this
  // line (see the note in .github/workflows/release.yml for why the config
  // picks the strategy it does).
  //
  // `deno desktop` bakes this into the built dylib as `Deno.desktopVersion`,
  // which the in-app updater compares with the latest GitHub release, and
  // into Info.plist, where the updater checks a download's version and Finder
  // shows it.
  "version": "0.2.0", // x-release-please-version
  "tasks": {
    // Writes reach agent config folders (~/.claude, ~/.codex, and Ori profile
    // folders such as ~/.claude-work) and repos for Integrate, so the grant is
    // $HOME; main.ts and src/ decide which files are actually touched.
    "dev": "deno desktop --hmr --allow-read=$HOME --allow-write=$HOME --allow-run=open,claude --allow-env=HOME,DENO_SERVE_ADDRESS,CLAUDE_CONFIG_DIR,CODEX_HOME --allow-net=127.0.0.1,api.github.com main.ts",
    // Unlike `dev` above, the filesystem grants here are unscoped, and they
    // have to be. Deno bakes permission paths into the binary at build time,
    // and `$HOME` is expanded by the task shell as it does so — so a build on
    // a CI runner ships an app permitted to read /Users/runner and nothing
    // else. That's how v0.1.1 launched to an empty window: scanDomains() was
    // denied and found zero domains on every machine but the build machine.
    // There is no runtime-resolved form either: `--allow-read=~/x` is stored
    // literally and never expanded, so it grants nothing at all.
    //
    // The path scoping was always defence-in-depth rather than the control —
    // main.ts gates every memory action on the path living inside a known
    // store, and hoist writes only the agents' own instruction files.
    //
    // The GitHub hosts and the extra tools are the updater's (src/update.ts):
    // the release API, the asset download and the CDN it redirects to, then
    // unpacking, version and signature checks, and the installer. Running zsh
    // amounts to running anything, which unscoped --allow-write already does.
    //
    // --output names the bundle without its extension: deno appends ".app"
    // even to a path that already ends in it, despite its help text.
    //
    // This is the raw build; package:mac finishes and re-signs the bundle.
    "build:mac": "deno desktop --output dist/MemGui --allow-read --allow-write --allow-run=open,claude,/usr/bin/ditto,/usr/bin/codesign,/usr/sbin/spctl,/usr/bin/plutil,/bin/zsh --allow-env=HOME,DENO_SERVE_ADDRESS,CLAUDE_CONFIG_DIR,CODEX_HOME --allow-net=127.0.0.1,api.github.com,github.com,release-assets.githubusercontent.com main.ts",
    // The build that ships: see scripts/package_app.zsh.
    "package:mac": "zsh scripts/package_app.zsh",
    // Build from source and install to /Applications, as an update would.
    "install": "zsh scripts/package_app.zsh && zsh scripts/install.zsh dist/MemGui.app",
    "fmt": "deno fmt",
    "lint": "deno lint",
    // One-time interactive setup for the release workflow's Apple secrets. The
    // read/write grants are broad because the .p12 and .p8 it reads live
    // wherever you exported them, and verifying the cert needs a scratch
    // keychain in the system temp dir — both outside anything narrower.
    "setup:release": "deno run --allow-run=gh,security,xcrun --allow-read --allow-write --allow-env=HOME scripts/setup_release.ts",
    // Tests write only to their own temp dir, but that lives outside $HOME, so
    // the read/write grants can't be narrowed the way the app's are.
    "test": "deno test --allow-env --allow-read --allow-write",
    // Everything CI runs, in one command — see .github/workflows/ci.yml.
    // Named "checks" (plural) so it doesn't read as a wrapper for `deno check`,
    // which is only one of the four steps it runs.
    "checks": "deno fmt --check && deno lint && deno check main.ts src scripts && deno test --allow-env --allow-read --allow-write"
  },
  "desktop": {
    "app": {
      "name": "Mem GUI",
      "identifier": "dev.johnstonmatt.mem-gui",
      "icons": {
        "macos": "./assets/icon.icns"
      }
    },
    "macos": {
      // Ad-hoc ("-") so `deno task build:mac` works on any machine, with or
      // without an Apple Developer cert. That's enough code identity for the
      // OS to remember the app, but Gatekeeper still warns once it's been
      // downloaded. scripts/package_app.zsh swaps in the real Developer ID
      // when CODESIGN_IDENTITY is set, as it is for releases. There's no CLI
      // flag for it, hence scripts/set_codesign_identity.ts.
      "codesignIdentity": "-"
    }
  },
  "compilerOptions": {
    "lib": ["deno.window", "deno.desktop"]
  },
  // Design assets are authored by hand/tooling, not written to deno fmt's
  // style — reformatting icon.svg is pure churn and would make CI demand it.
  // CHANGELOG.md is the same case and not optional: release-please regenerates
  // it from scratch every release with "*" bullets and unwrapped lines, so
  // formatting it here would fail CI on the release PR, and "fixing" that by
  // committing the formatted version just gets overwritten by the next release.
  "fmt": {
    "exclude": ["assets", "dist", "CHANGELOG.md"]
  },
  // Intentionally empty: pulling any remote module into the graph breaks
  // `deno desktop`'s webview bindings (see the note at the top of
  // src/paths.ts). Keep this app dependency-free.
  "imports": {}
}
