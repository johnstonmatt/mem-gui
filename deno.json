{
  "tasks": {
    "dev": "deno desktop --hmr --allow-read=$HOME --allow-write=$HOME/.claude,$HOME/dev --allow-run=open,claude --allow-env=HOME,DENO_SERVE_ADDRESS --allow-net=127.0.0.1 main.ts",
    "build:mac": "deno desktop --output dist/MemGui.app --allow-read=$HOME --allow-write=$HOME/.claude,$HOME/dev --allow-run=open,claude --allow-env=HOME,DENO_SERVE_ADDRESS --allow-net=127.0.0.1 main.ts"
  },
  "desktop": {
    "app": {
      "name": "Mem GUI",
      "identifier": "dev.johnstonmatt.mem-gui",
      "icons": {
        "macos": "./assets/icon.icns"
      }
    }
  },
  "compilerOptions": {
    "lib": ["deno.window", "deno.desktop"]
  },
  // Intentionally empty: pulling any remote module into the graph breaks
  // `deno desktop`'s webview bindings (see the note at the top of
  // src/paths.ts). Keep this app dependency-free.
  "imports": {}
}
